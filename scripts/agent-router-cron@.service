[Unit]
Description=Agent Router cron session — %i
Documentation=https://github.com/gspivey/agent-router
# Run after the daemon is up so the session can be registered and routed.
After=network.target agent-router.service

[Service]
Type=oneshot
# ExecStart runs the agent-router prompt command with a flock guard so that
# if the previous timer fire is still running the new one exits immediately
# rather than spawning a second session on the same instance.
#
# Replace the paths below:
#   /usr/local/bin/agent-router  — absolute path to the agent-router CLI
#   /etc/agent-router/prompts/%i.md — prompt file for this instance (%i is the
#                                     systemd template parameter, e.g. "myrepo")
#
ExecStart=/usr/bin/flock -n /var/lock/agent-router-cron-%i.lock \
    /bin/sh -c '/usr/local/bin/agent-router prompt --new --quiet \
        < /etc/agent-router/prompts/%i.md'
# Standard output and errors go to the journal.
StandardOutput=journal
StandardError=journal
# Run as the agent-router operator user.
# Replace with your actual daemon user if different.
User=agentrouter
# If flock cannot acquire the lock (previous run still active), exit 1.
# SuccessExitStatus tells systemd to treat exit 1 from flock as a success so
# the timer's next fire is not blocked.
SuccessExitStatus=1
